# ============================================================================
# SEC Filing RAG — Environment Configuration
# Copy this file to .env. 100% FREE — uses Google's Gemini API free tier.
# ============================================================================

# ----- Gemini API key (REQUIRED) -----
# Get a free API key in 30 seconds at: https://aistudio.google.com/app/apikey
# Just sign in with Google — no credit card required!
# Free tier: 1,000 requests/day on gemini-2.5-flash-lite
GOOGLE_API_KEY=paste_your_free_gemini_key_here

# ----- Gemini model (optional, default works fine) -----
# Free options:
#   gemini-2.5-flash-lite  →  15 RPM, 1000 RPD  (default — best for RAG)
#   gemini-2.5-flash       →  10 RPM, 250 RPD   (more capable)
#   gemini-2.5-pro         →  5 RPM, 100 RPD    (best quality)
GEMINI_MODEL=gemini-2.5-flash-lite

# ----- Embeddings (free, runs locally) -----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# ----- Vector store (free, runs on disk) -----
VECTOR_STORE=faiss
VECTOR_STORE_DIR=data/vectorstore

# ----- Chunking -----
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ----- Retrieval -----
TOP_K=4
SIMILARITY_THRESHOLD=0.3

# ----- Generation -----
TEMPERATURE=0.1
MAX_TOKENS=1024

# ----- API -----
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# ----- Data paths -----
FILINGS_DIR=data/sample_filings
